rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อมูลทีมทั้งหมดอยู่ใน collection "planner"
    match /planner/{docId} {
      // ทุกคนอ่านได้ (ไม่ต้องล็อกอิน)
      allow read: if true;

      // เขียน/ลบได้เฉพาะผู้ดูแลที่ล็อกอินด้วยอีเมลตามรายการนี้
      // แก้อีเมลให้ตรงกับผู้ดูแลจริง ใส่ได้หลายคนคั่นด้วย comma
      allow write: if request.auth != null
                   && request.auth.token.email in ['kuntapongz.101@gmail.com'];
    }

    // ที่อื่นปิดทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
